# Copy this file to ".env" and fill in your key.
# The server loads this file from its own directory at startup.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: point at a brands.json kept outside this repo (e.g. under ~/.config).
# If unset, the server looks for ./brands.json, then falls back to ./brands.example.json.
# GEMINI_SOCIAL_BRANDS_PATH=C:/Users/smart/.config/gemini-social/brands.json
